LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=replace-with-your-api-key
LLM_INPUT_COST_PER_1M_TOKENS=0
LLM_OUTPUT_COST_PER_1M_TOKENS=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
DATABASE_URL=sqlite:///data/ai_software_team.db
JWT_SECRET=replace-with-a-long-random-secret
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-local-dev-password
LOG_LEVEL=INFO

# For OpenAI-compatible providers, set:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://provider.example.com/openai/v1
# LLM_MODEL=provider-model-name
# LLM_API_KEY=replace-with-provider-api-key

# For local Ollama, set:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1

# Container sandbox for AI-generated code execution.
# Requires Docker. Generated code is never executed on the API host when enabled.
SANDBOX_ENABLED=false
SANDBOX_DOCKER_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_ALLOW_NETWORK=false
